{
  "name": "terraform-diagrams",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y graphviz libgvplugin-neato-layout8 && sudo dot -c && pip install --user terravision terraformgraph",

  "customizations": {
    "vscode": {
      "extensions": ["hashicorp.terraform", "bierner.markdown-mermaid"]
    }
  },

  // Uncomment if your providers need credentials (AWS shown)
  // "mounts": [
  //   "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly"
  // ],

  "remoteUser": "vscode"
}
